function _update60()
  cur_frame += 1
  if ui_state == "intro" then
    update_intro()
  elseif ui_state == "level_select" then
    update_level_select()
  end
end

function _draw()
  if ui_state == "intro" then
    draw_intro()
  elseif ui_state == "level_select" then
    draw_level_select()
  end
end

