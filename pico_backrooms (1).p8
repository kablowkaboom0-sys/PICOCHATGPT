pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- pico backrooms
-- electricgryphon 2026

cartdata("backrooms_level_save-01")

cur_frame = 0

-- input mode
input_mode="mouse"
pad_cx=64
pad_cy=64
pad_speed=2

------------------------------------------------------------
-- level list
-- add spr= for thumbnail sprite location (top-left spr index)
-- spr_w / spr_h = size in sprites (default 2x2)
------------------------------------------------------------
-- at the top, update level_list
level_list={
  [1]={name="backrooms_floor1", fc=9,  cc=15, label="lvl 0", desc="the backrooms", spr=64,  spr_w=4, spr_h=4},
  [2]={name="poolrooms_floor2", fc=7,  cc=1,  label="pool", desc="poolrooms",     spr=68,  spr_w=4, spr_h=4},
  [3]={name="levelfun_floor3", fc=5,  cc=1,  label="lvl fn", desc="the dark room", spr=72,  spr_w=4, spr_h=4},
  
  [4]={name="storage_level5",    fc=5,  cc=1 ,label="basmnt", desc="the dark room", spr=76,  spr_w=4, spr_h=4},
  [5]={name="office_level8",    fc=7,  cc=7 ,label="office", desc="the dark room", spr=128,  spr_w=4, spr_h=4},
  
}

------------------------------------------------------------
-- ui state
-- "intro"       : title screen with static animation
-- "level_select": pick a level
------------------------------------------------------------
ui_state = "intro"

-- intro: wait for any click/button
intro_any_press = false

------------------------------------------------------------
-- quick color / gradients  (kept from original)
------------------------------------------------------------
gradients={[0]={0,0,1,256},
  {0,-32,0,1,1,224,1,256},
  {0,-32,0,1,2,224,2,256},
  {0,-32,0,1,3,224,3,256},
  {0,-32,0,1,2,32,4,224,4,256},
  {0,-32,0,1,5,224,5,256},
  {0,-32,0,1,5,64,6,224,6,256},
  {0,-32,0,1,5,32,6,128,7,224,7,256},
  {0,-32,0,1,2,16,8,200,8,256},
  {0,-32,0,1,2,16,4,32,9,224,9,256},
  {0,-32,0,1,4,32,9,64,10,224,10,256},
  {0,-32,0,1,3,32,11,224,11,256},
  {0,-32,0,1,13,32,12,224,12,256},
  {0,-16,0,1,13,224,13,256},
  {0,-32,0,1,2,16,8,64,14,224,14,256},
  {0,-32,0,1,2,16,4,32,15,224,15,256},
  {1,-32,13,16,12,127,6,150,7,256},
}

gray_patterns={[0]=0b0.1000000000000000,
  0b0.1000000000100000,
  0b0.1000000010100000,
  0b0.1010000010100000,
  0b0.1010010010100000,
  0b0.1010010010100001,
  0b0.1010010010100101,
  0b0.1010010110100101,
  0b0.1110010110100101,
  0b0.1110010110110101,
  0b0.1110010111110101,
  0b0.1111010111110101,
  0b0.1111010111110111,
  0b0.1111110111110111,
  0b0.1111110111111111,
  0b0.1111111111111111
}

function set_color_and_pattern(c1,c2,mix)
  local color=bor(0x1000,shl(c2,4))
  color=bor(color,c1)
  return bor(color,gray_patterns[flr(mix)])
end

shades={}
function create_shades()
  for shade_num,grad in pairs(gradients) do
    shades[shade_num]={}
    local index=1
    local high_step=grad[index+3]
    for i=0,255 do
      if i>=high_step then index+=2 end
      local low_color=grad[index]
      local high_color=grad[index+2]
      local low_step=grad[index+1]
      high_step=grad[index+3]
      local mix=((i-low_step)/(high_step-low_step))*16
      shades[shade_num][i]=set_color_and_pattern(low_color,high_color,mix)
    end
  end
end

function grad_rect(x1,y1,x2,y2,shade,v_start,v_end)
  local h=y2-y1
  if h<=0 then return end
  for y=y1,y2 do
    local t=(y-y1)/h
    local v=mid(0,flr(v_start+(v_end-v_start)*t),255)
    rectfill(x1,y,x2,y,shades[shade][v])
  end
  fillp()
end

------------------------------------------------------------
-- mouse / input
------------------------------------------------------------
local cur_ox=6
local cur_oy=0

function init_mouse()
  poke(0x5f2d,1)
  update_mouse()
  mouse_down_x=mouse_x
  mouse_down_y=mouse_y
  last_mouse_x=mouse_x
  last_mouse_y=mouse_y
  last_mouse_down=mouse_down
  tx=mouse_x
  ty=mouse_y
  last_click_time=0
end

function update_mouse()
  last_mouse_x=mouse_x
  last_mouse_y=mouse_y
  mouse_x=mid(stat(32),0,127)
  mouse_y=mid(stat(33),0,127)
  last_mouse_down=mouse_down
  if band(stat(34),1)==1 then
    mouse_down=true
    if not last_mouse_down then
      mouse_down_x=mouse_x
      mouse_down_y=mouse_y
      last_click_time=cur_frame
    end
  else
    mouse_down=false
  end
  if mouse_x!=last_mouse_x or mouse_y!=last_mouse_y then
    input_mode="mouse"
  end
  if btn(0) or btn(1) or btn(2) or btn(3) or btn(4) or btn(5) then
    input_mode="pad"
  end
  if input_mode=="pad" then
    if btn(0) then pad_cx=max(0,   pad_cx-pad_speed) end
    if btn(1) then pad_cx=min(127, pad_cx+pad_speed) end
    if btn(2) then pad_cy=max(0,   pad_cy-pad_speed) end
    if btn(3) then pad_cy=min(127, pad_cy+pad_speed) end
  end
end

function get_cursor_x()
  return input_mode=="pad" and pad_cx or mouse_x
end

function get_cursor_y()
  return input_mode=="pad" and pad_cy or mouse_y
end

function cursor_click()
  if input_mode=="pad" then
    return btnp(4) or btnp(5)
  end
  return mouse_down==true and last_mouse_down==false
end

function any_press()
  if mouse_down==true and last_mouse_down==false then return true end
  for i=0,5 do
    if btnp(i) then return true end
  end
  return false
end

function in_rect(x,y,x1,y1,x2,y2)
  if x2<x1 then x1,x2=x2,x1 end
  if y2<y1 then y1,y2=y2,y1 end
  return x>=x1 and x<x2 and y>=y1 and y<y2
end

function draw_mouse()
	pal()
	palt(0,false)
	palt(14,true)
  spr(37, get_cursor_x()-cur_ox, get_cursor_y()-cur_oy, 2, 2)
end

------------------------------------------------------------
-- fade helpers
------------------------------------------------------------
fade_level    = 0
fade_order={7,10,15,11,9,13,6,14,12,4,8,5,3,2,1,0}

function do_fade(to_level, callback)
  local step = to_level > fade_level and 1 or -1
  while fade_level != to_level do
    fade_level += step
    pal({},1)
    for i=1,fade_level do
      pal(fade_order[i], 0, 1)
    end
    flip()
  end
  if callback != nil then callback() end
end

function fade_out(callback)
  do_fade(#fade_order, callback)
end

function fade_in(callback)
  do_fade(0, callback)
end

------------------------------------------------------------
-- fast noise background
-- uses user memory 0x8000 as a noise buffer (one screenful = 0x2000 bytes)
-- each byte encodes two pixels (nibble per pixel), so 2px wide elements.
-- on each frame we blit the buffer to screen memory (0x6000) with a
-- random rolling byte-offset so the static appears to move.
------------------------------------------------------------
k_noise_addr  = 0x8000
k_screen_addr = 0x6000
k_noise_size  = 0x2000  -- 128*128/2 bytes = one screenful

-- standard palette colours used for noise (edit to taste)
--   0=black  1=dark-blue  5=dark-grey
--   6=light-grey  7=white  13=lavender
noise_colors = {0, 1, 5, 6, 13}

-- build every nibble-pair byte from noise_colors
noise_palette = {}
for i=1,#noise_colors do
  for j=1,#noise_colors do
    add(noise_palette, noise_colors[i]*16 + noise_colors[j])
  end
end
k_pal_size = #noise_palette

function init_noise_buf()
  for i=0, k_noise_size-1 do
    poke(k_noise_addr + i, noise_palette[flr(rnd(k_pal_size))+1])
  end
end

function draw_static_bg()
  -- pick a random byte offset within the buffer (must stay < k_noise_size)
  local off = flr(rnd(k_noise_size))

  -- blit: [off .. end] -> screen start
  local first_chunk = k_noise_size - off
  memcpy(k_screen_addr,           k_noise_addr + off, first_chunk)

  -- blit: [0 .. off-1]  -> screen remainder
  if off > 0 then
    memcpy(k_screen_addr + first_chunk, k_noise_addr, off)
  end
end

------------------------------------------------------------
-- title text helpers
------------------------------------------------------------
-- chromatic aberration print
-- draws col_r shifted left, col_l shifted right, then white on top
-- colors cycle each frame so the fringing animates
function chr_print(str, x, y, scale)
  local prefix = scale==2 and "\^w\^t" or ""
  if cur_frame%2==0 then
    print(prefix..str, x-1, y, 12)  -- cyan left
  else
    print(prefix..str, x+1, y, 8)   -- red right
  end
  print(prefix..str, x, y, 7)
end

function draw_title()
  local t1 = "pico"
  local t2 = "backrooms"
  local cw = 10  -- double-width chars
  local lh = 18  -- line height for double-size text
  local x1 = 64 - (#t1 * cw) / 2
  local x2 = 64 - (#t2 * cw) / 2
  local y1 = 42
  chr_print(t1, x1, y1,      2)
  chr_print(t2, x2, y1 + lh, 2)
end

function draw_press_prompt()
  local visible = (cur_frame\40)%2 == 0
  if visible then
    local msg = "press any button"
    local x = 64 - (#msg * 5) / 2
    chr_print(msg, x, 90, 1)
  end
end

distort_timer = 0
distort_active = false

function update_distort()
  distort_timer -= 1
  if distort_timer <= 0 then
    distort_active = not distort_active
    if distort_active then
      distort_timer = 60  -- active for ~1 second
    else
      distort_timer = flr(rnd(180) + 120)  -- off for 2-5 seconds
    end
  end
end

function draw_scan_distort()
  if not distort_active then return end
  local t = cur_frame * 0.04
  for y=16,111 do
    local wobble = sin(t + y*0.03) * 0.8
               + sin(t*1.7 + y*0.07) * 0.4
    local shift = flr(wobble)
    if shift != 0 then
      local row_addr = k_screen_addr + y * 64
      if shift > 0 then
        memcpy(row_addr + shift, row_addr, 64 - shift)
      else
        memcpy(row_addr, row_addr - shift, 64 + shift)
      end
    end
  end
end

function draw_spr_chr(n, x, y, w, h)
	
  if cur_frame%2==0 then
    pal(7, 12)  -- cyan
	palt(14,true)
	palt(0,false)
    spr(n, x-1, y, w, h)
  else
    pal(7, 8)   -- red
	palt(14,true)
	palt(0,false)
    spr(n, x+1, y, w, h)
  end
  pal()
  palt(14,true)
	palt(0,false)
  spr(n, x, y, w, h)
end

vhs_time = 0

function update_vhs()
  vhs_time += 1
end

function fmt_vhs_time()
  local total_s = vhs_time \ 60
  local total_m = total_s \ 60
  local h = total_m \ 60
  local m = total_m % 60
  local s = total_s % 60
  local ms = (vhs_time % 60) \ 6  -- 0-9 sub-second digit
  local function pad(n)
    return (n < 10 and "0" or "") .. n
  end
  return "slp:" .. h .. ":" .. pad(m) .. ":" .. pad(s)
end
function draw_vhs_ui()
  -- play + arrow sprite, upper left
  chr_print("play", 4, 18, 1)
  draw_spr_chr(2, 26, 17, 1, 1)

  -- channel upper right
  local ch = "ch 03"
  chr_print(ch, 125 - #ch*5, 18, 1)

  -- timecode bottom right
  local tc = fmt_vhs_time()
  chr_print(tc, 125 - #tc*5, 103, 1)
end
------------------------------------------------------------
-- go_exit: load a level the same way the original did
------------------------------------------------------------
function go_exit(idx)
  local lvl=level_list[idx]
  if lvl==nil then return end
  fade_out(function()
    pal()
    open_doors(lvl.fc, lvl.cc)
  end)
  load("#"..lvl.name)
  -- fallbacks (desktop / exported cart)
   load(lvl.name..".p8")
   load(lvl.name..".png")
end

function open_doors(floor_shade, ceil_shade)
  local door=0
  local speed=2
  while door<=64 do
    grad_rect(0,0,127,63,ceil_shade,200,16)
    grad_rect(0,64,127,127,floor_shade,16,200)
    grad_rect(0,0,64-door,127,5,32,150)
    grad_rect(0,0,64-door-4,127,6,32,200)
    grad_rect(127,0,64+door,127,5,32,150)
    grad_rect(127,0,64+door+4,127,6,32,200)
    flip()
    door+=speed
  end
end

-----------------------------------------------------------
-- overlay 
-----------------------------------------------------------

function draw_bezel()
	palt(14,true)
	palt(0,false)
  rectfill(0,   0, 127, 15, 0)  -- top bar
  rectfill(0, 112, 127,127, 0)  -- bottom bar
  -- upper-left: flip both axes
  sspr(96,0, 32,32,  0,  15, 32,32, true, false)
  -- upper-right: default orientation
  sspr(96,0, 32,32, 96,  15, 32,32, false,false)
  -- lower-left: flip vertical only
  sspr(96,0, 32,32,  0, 96-15, 32,32, true, true)
  -- lower-right: flip horizontal only
  sspr(96,0, 32,32, 96, 96-15, 32,32, false,true)
  
  spr(0,3,18,2,2)
  
end


------------------------------------------------------------
-- intro screen
------------------------------------------------------------
function update_intro()
  update_mouse()
   update_distort()
  if any_press() then
    -- transition to level select
    fade_out(function()
      pal()
      ui_state="level_select"
      init_level_select()
    end)
    fade_in()
  end
end

function draw_intro()
  draw_static_bg()
--cls(9)
 draw_title()
 draw_press_prompt()
 draw_vhs_ui()
 draw_scan_distort()
 draw_bezel()
 draw_mouse()
end

------------------------------------------------------------
-- level select screen
------------------------------------------------------------
sel_hover  = 0
level_page = 1
levels_per_page = 3

function init_level_select()
  sel_hover  = 0
  level_page = 1
  pad_cx = 64
  pad_cy = 64
end

function get_page_levels()
  local s=(level_page-1)*levels_per_page+1
  local e=min(#level_list,level_page*levels_per_page)
  local t={}
  for i=s,e do add(t,{idx=i,lvl=level_list[i]}) end
  return t
end

function total_pages()
  return ceil(#level_list/levels_per_page)
end

function card_rect(slot)
  local n=min(levels_per_page,#level_list-(level_page-1)*levels_per_page)
  local card_w=36  -- 2px pad + 32px spr + 2px pad
  local gap=6
  local total_w=n*card_w+(n-1)*gap
  local ox=flr((128-total_w)/2)
  local oy=36
  local x=ox+(slot-1)*(card_w+gap)
  -- height: 2px top pad + 32px spr + 2px gap + 6px label + 4px bottom pad = 46
  return x,oy,x+card_w,oy+46
end

-- hit rects for more/back buttons (right-aligned "more>", left "< back")
local more_rect={102,90,126,98}
local back_rect={2,90,30,98}
function move_pad_to_card(slot)
  local x1,y1,x2,y2=card_rect(slot)
  pad_cx=flr((x1+x2)/2)
  pad_cy=flr((y1+y2)/2)
end
function update_level_select()
  update_mouse()
  update_distort()
  update_vhs()
  local cx,cy=get_cursor_x(),get_cursor_y()
  local pg=get_page_levels()
  sel_hover=0
  for i,v in ipairs(pg) do
    local x1,y1,x2,y2=card_rect(i)
    if in_rect(cx,cy,x1,y1,x2,y2) then sel_hover=v.idx end
  end
  if cursor_click() then
    if sel_hover>0 then
      go_exit(sel_hover)
    elseif level_page<total_pages() and in_rect(cx,cy,more_rect[1],more_rect[2],more_rect[3],more_rect[4]) then
      level_page+=1 sel_hover=0
    elseif level_page>1 and in_rect(cx,cy,back_rect[1],back_rect[2],back_rect[3],back_rect[4]) then
      level_page-=1 sel_hover=0
    end
  end
end


function draw_level_select()
  draw_static_bg()

  local hdr="select level"
  chr_print(hdr,64-#hdr*5/2,20,1)

  local pg=get_page_levels()
  for i,v in ipairs(pg) do
    local lvl=v.lvl
    local x1,y1,x2,y2=card_rect(i)
    local cw=x2-x1
    rrectfill(x1,y1,cw,46,3,0)
    rrect(x1,y1,cw,46,3,sel_hover==v.idx and 7 or 5)
    -- sprite: 2px from edges
    spr(lvl.spr,x1+2,y1+2,lvl.spr_w,lvl.spr_h)
    -- label: 2px below sprite, centered
    local lbl=lvl.label
    chr_print(lbl,x1+flr((cw-#lbl*5)/2),y1+36,1)
  end

  -- centered hint
  local hint="click to load"
  chr_print(hint,64-#hint*5/2,94,1)
  -- more right-aligned, back left-aligned
  if level_page<total_pages() then
    local more="more>"
    chr_print(more,127-#more*5,94,1)
  end
  if level_page>1 then
    chr_print("<back",2,94,1)
  end

  draw_vhs_ui()
  draw_scan_distort()
  draw_bezel()
  draw_mouse()
end

------------------------------------------------------------
-- main
------------------------------------------------------------
function _init()
	music(0)
	sfx(4)
  init_noise_buf()
  print("\^l",0,0,0)
  palt(0,false)
  palt(14,true)
  cls()
  create_shades()
  poke(0x5f34,1)  -- enable mouse
